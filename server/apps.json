[
  {
    "name": "lab",
    "repo": "https://github.com/nimrodtalmon/BGULAB.git",
    "port": 4101,
    "env": {
      "BASE_PATH": "/lab",
      "GITHUB_REPO": "nimrodtalmon/BGULAB"
    },
    "secrets": [
      "GOVERN_PASS",
      "GITHUB_TOKEN",
      "SESSION_SECRET"
    ],
    "start": ".\\.venv\\Scripts\\uvicorn app.main:app --host 127.0.0.1 --port 4101"
  },
  {
    "name": "cdw",
    "repo": "https://github.com/nimrodtalmon/CDW.git",
    "port": 4201,
    "env": {
      "HF_HOME": "C:\\sites\\cdw-cache"
    },
    "start": ".\\.venv\\Scripts\\waitress-serve --host 127.0.0.1 --port 4201 app:app"
  },
  {
    "name": "gas",
    "aliases": [
      "gas2",
      "glp"
    ],
    "repo": "https://github.com/nimrodtalmon/GLP.git",
    "branch": "main",
    "port": 5101,
    "workdir": "C:\\sites\\gas\\servers\\gas2",
    "env": {
      "PORT": "5101",
      "DATA": "C:\\sites\\gas2-data",
      "DART": "C:\\tools\\dart-sdk\\bin\\dart.exe"
    },
    "start": "& (Get-Content 'C:\\sites\\python.txt' -TotalCount 1) -I server.py 5101"
  },
  {
    "name": "gasweb",
    "aliases": [
      "gas2web"
    ],
    "repo": "https://github.com/nimrodtalmon/GLP.git",
    "branch": "main",
    "port": 5201,
    "build": "build-gasweb.ps1",
    "workdir": "C:\\sites\\gasweb\\servers\\gas2\\device",
    "env": {
      "PORT": "5201",
      "DATA": "C:\\sites\\gas2web-data",
      "GAS2_DATA": "C:\\sites\\gas2-data",
      "LIBSODIUM_PATH": "C:\\sites\\libsodium\\libsodium.dll",
      "RELAY_URL": "http://127.0.0.1:4601",
      "GAS2_SITE": "http://127.0.0.1:5101"
    },
    "start": "C:\\tools\\dart-sdk\\bin\\dart.exe bin\\web.dart"
  },
  {
    "name": "gasrelay",
    "repo": "https://github.com/nimrodtalmon/talmonlab.git",
    "port": 4601,
    "build": "build-gasrelay.ps1",
    "workdir": "C:\\sites\\gasrelay\\server\\gasrelay",
    "env": {
      "DATA": "C:\\sites\\gasrelay-data"
    },
    "start": "C:\\tools\\dart-sdk\\bin\\dart.exe bin\\relay.dart 4601"
  },
  {
    "name": "cgraph",
    "repo": "https://github.com/nimrodtalmon/cgraph.git",
    "port": 4801,
    "env": {
      "DATA": "C:\\sites\\cgraph-data"
    },
    "start": "& (Get-Content 'C:\\sites\\python.txt' -TotalCount 1) server.py 4801"
  },
  {
    "name": "gcv",
    "repo": "https://github.com/nimrodtalmon/GFV.git",
    "port": 5001,
    "workdir": "C:\\sites\\gcv\\app",
    "env": {
      "DATA": "C:\\sites\\gcv-data",
      "PORT": "5001"
    },
    "start": "& (Get-Content 'C:\\sites\\python.txt' -TotalCount 1) server.py 5001",
    "aliases": [
      "gfv"
    ]
  }
]

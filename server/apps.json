[
  {
    "name": "lab",
    "repo": "https://github.com/nimrodtalmon/BGULAB.git",
    "port": 4101,
    "env": {
      "BASE_PATH": "/lab",
      "GITHUB_REPO": "nimrodtalmon/BGULAB"
    },
    "secrets": [
      "GOVERN_PASS",
      "GITHUB_TOKEN",
      "SESSION_SECRET"
    ],
    "start": ".\\.venv\\Scripts\\uvicorn app.main:app --host 127.0.0.1 --port 4101"
  },
  {
    "name": "cdw",
    "repo": "https://github.com/nimrodtalmon/CDW.git",
    "port": 4201,
    "env": {
      "HF_HOME": "C:\\sites\\cdw-cache"
    },
    "start": ".\\.venv\\Scripts\\waitress-serve --host 127.0.0.1 --port 4201 app:app"
  },
  {
    "name": "gasrelay",
    "repo": "https://github.com/nimrodtalmon/talmonlab.git",
    "port": 4601,
    "build": "build-gasrelay.ps1",
    "workdir": "C:\\sites\\gasrelay\\server\\gasrelay",
    "env": {
      "DATA": "C:\\sites\\gasrelay-data"
    },
    "start": "C:\\tools\\dart-sdk\\bin\\dart.exe bin\\relay.dart 4601"
  },
  {
    "name": "cgraph",
    "repo": "https://github.com/nimrodtalmon/cgraph.git",
    "port": 4801,
    "env": {
      "DATA": "C:\\sites\\cgraph-data"
    },
    "start": "& (Get-Content 'C:\\sites\\python.txt' -TotalCount 1) server.py 4801"
  },
  {
    "name": "gcv",
    "repo": "https://github.com/nimrodtalmon/GFV.git",
    "port": 5001,
    "workdir": "C:\\sites\\gcv\\app",
    "env": {
      "DATA": "C:\\sites\\gcv-data",
      "PORT": "5001"
    },
    "start": "& (Get-Content 'C:\\sites\\python.txt' -TotalCount 1) server.py 5001",
    "aliases": [
      "gfv"
    ]
  }
]

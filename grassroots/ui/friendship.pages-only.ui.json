{
 "name": "Pages only",
 "start": "Home",
 "containers": {
  "Home": {"params": [], "components": [
   {"id": "me", "kind": "details", "about": "me", "shows": ["identity", "person"]},
   {"id": "establish", "kind": "action", "act": "establish", "bind": {}},
   {"id": "inbox", "kind": "inbox"},
   {"id": "people", "kind": "list", "title": "Contacts", "items": {"named": true},
    "shows": ["knows"], "event": {"navigate": "Person", "bind": {"p": "item"}}}
  ]},
  "Person": {"params": ["p"], "components": [
   {"id": "acquaint", "kind": "action", "act": "acquaint", "bind": {"Bob": "p"}},
   {"id": "befriend", "kind": "action", "act": "befriend", "bind": {"Bob": "p"}},
   {"id": "unfriend", "kind": "action", "act": "unfriend", "bind": {"Bob": "p"}},
   {"id": "introduce-to", "kind": "action", "act": "introduce", "bind": {"Bob": "p", "Carol": {"select": "others"}}},
   {"id": "others", "kind": "list", "title": "Contacts", "items": {"named": true}, "role": "choices"}
  ]}
 }
}

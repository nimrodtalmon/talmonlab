# Chats, on Groups as it is: a person keeps only the messages they receive.
screen Chats
  top
    inbox
  middle
    me: identity, person
    list Groups: atoms of member; opens Group
    list Contacts: everyone; shows knows, friend; opens Chat
  bottom
    Establish
    Acquaint: Bob = field
    Create: Grupo = field
    Close: Grupo = pick of leader

screen Chat(p)
  top
    inbox
  middle
    p: knows, friend
    thread: message
  bottom
    Befriend: Bob = p
    Unfriend: Bob = p
    Introduce: Bob = p, Carol = pick of knows
    Introduce: Carol = p, Bob = pick of knows
    Join: Bob = p, Grupo = pick of leader
    Remove: Bob = p, Grupo = pick of listed
    Message: Bob = p, Text = field

screen Group(g)
  top
    inbox
  middle
    g: member, leader, listed, posted, group_delivered
    thread: group_message
  bottom
    Leave: Grupo = g.1, Alice = g.2
    Post: Grupo = g.1, Alice = g.2, Text = field
    Post own: Grupo = g.1, Text = field

# People: one screen of people, one screen per person.
screen Home
  inbox
  me: identity, person
  list Contacts: everyone; shows knows, friend; opens Person
  Establish
  Acquaint: Bob = field

screen Person(p)
  p: knows, friend
  Befriend: Bob = p
  Unfriend: Bob = p
  Introduce: Bob = p, Carol = pick of knows
  Introduce: Carol = p, Bob = pick of knows
